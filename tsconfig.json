{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@adea-ai/plugins": ["./packages/plugins/src/index.ts"],
      "@adea-ai/plugins/schema": ["./packages/plugins/src/schema.ts"],
      "@adea-ai/plugins/sources": ["./packages/plugins/src/sources.ts"],
      "@adea-ai/plugins/harness": ["./packages/plugins/src/harness.ts"],
      "@adea-ai/plugins/publication": ["./packages/plugins/src/publication.ts"],
      "@adea-ai/plugins/portable-catalog": ["./packages/plugins/src/portable-catalog.ts"],
      "@adea-ai/plugins/agent-plugins": ["./packages/plugins/src/agent-plugins-catalog.ts"],
      "@adea-ai/plugins/agent-plugins/schema": ["./packages/plugins/src/agent-plugins-schema.ts"],
      "@adea-ai/plugins/agent-plugins/harness": ["./packages/plugins/src/agent-plugins-harness.ts"]
    }
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
