{
  "name": "@adea-ai/catalog-core",
  "version": "1.3.1",
  "description": "Deterministic compiler for AI agent plugin marketplaces: parse, verify, merge, and compile plugin catalogs into provenance-checked static artifacts.",
  "keywords": [
    "agents",
    "catalog",
    "compiler",
    "deterministic",
    "marketplace",
    "plugins",
    "provenance"
  ],
  "homepage": "https://github.com/adea-ai/plugins#readme",
  "bugs": "https://github.com/adea-ai/plugins/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/plugins.git",
    "directory": "packages/catalog-core"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./publication": {
      "types": "./dist/publication.d.ts",
      "bun": "./src/publication.ts",
      "import": "./dist/publication.js"
    },
    "./agent-plugins": {
      "types": "./dist/agent-plugins.d.ts",
      "bun": "./src/agent-plugins.ts",
      "import": "./dist/agent-plugins.js"
    },
    "./portable-catalog": {
      "types": "./dist/portable-catalog.d.ts",
      "bun": "./src/portable-catalog.ts",
      "import": "./dist/portable-catalog.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adea-ai/catalog-schema": "workspace:^",
    "@adea-ai/source-adapters": "workspace:^",
    "yaml": "2.9.0"
  },
  "engines": {
    "bun": ">=1.4.0 <2",
    "node": ">=24 <25"
  }
}
