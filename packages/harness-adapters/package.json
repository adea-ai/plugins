{
  "name": "@adea-ai/harness-adapters",
  "version": "1.3.0",
  "description": "Harness materialization for AI agent plugin marketplaces: translate catalog plugins into per-harness installation plans for Codex, Claude Code, Cursor, Pi, Hermes, and OpenCode.",
  "keywords": [
    "agents",
    "claude-code",
    "codex",
    "cursor",
    "harness",
    "marketplace",
    "plugins"
  ],
  "homepage": "https://github.com/adea-ai/plugins#readme",
  "bugs": "https://github.com/adea-ai/plugins/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/plugins.git",
    "directory": "packages/harness-adapters"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./agent-plugins": {
      "types": "./dist/agent-plugins.d.ts",
      "bun": "./src/agent-plugins.ts",
      "import": "./dist/agent-plugins.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adea-ai/catalog-core": "workspace:^",
    "@adea-ai/catalog-schema": "workspace:^"
  },
  "engines": {
    "bun": ">=1.4.0 <2",
    "node": ">=24 <25"
  }
}
