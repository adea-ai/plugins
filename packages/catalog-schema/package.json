{
  "name": "@adea-ai/catalog-schema",
  "version": "1.2.0",
  "description": "Deterministic catalog schema for AI agent plugin marketplaces: plugins, capabilities, releases, provenance, licensing, security classification, and per-harness compatibility.",
  "keywords": [
    "agents",
    "catalog",
    "marketplace",
    "mcp",
    "plugins",
    "schema",
    "skills",
    "zod"
  ],
  "homepage": "https://github.com/adea-ai/plugins#readme",
  "bugs": "https://github.com/adea-ai/plugins/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/plugins.git",
    "directory": "packages/catalog-schema"
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schemas/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "engines": {
    "bun": ">=1.4.0 <2",
    "node": ">=24 <25"
  }
}
